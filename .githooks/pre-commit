#!/usr/bin/env bash
# Team safety checks before every commit. Enabled by tools/setup.* (git config core.hooksPath .githooks).
# Bypass only in an emergency: git commit --no-verify  (CI runs the same checks on the PR anyway).
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
fail=0

# 1. Unity .meta consistency
if ! bash tools/check-meta.sh; then fail=1; fi

# 2. Never commit Unity's generated / per-machine folders
bad="$(git diff --cached --name-only --diff-filter=A | grep -E '^(Library|Temp|Obj|UserSettings|Logs)/|^\.codex-local/' | grep -v '^Logs/.gitkeep$' || true)"
if [ -n "$bad" ]; then echo "Generated or per-machine files staged:"; printf '  %s\n' $bad; fail=1; fi

# 3. Big binaries must go through Git LFS (see .gitattributes)
while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f")
  if [ "$size" -gt 5242880 ] && ! git check-attr filter -- "$f" | grep -q 'filter: lfs'; then
    echo "File over 5 MB not tracked by LFS: $f  (add its pattern to .gitattributes)"; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=AM)

# 4. Context index must match the C# sources being committed
if git diff --cached --name-only | grep -qE '^Assets/.*\.(cs|asmdef)$'; then
  ps=""
  command -v pwsh >/dev/null 2>&1 && ps=pwsh
  [ -z "$ps" ] && command -v powershell >/dev/null 2>&1 && ps=powershell
  if [ -n "$ps" ] && ! "$ps" -NoProfile -ExecutionPolicy Bypass -File tools/strata-index.ps1 -Verify >/dev/null; then
    echo "Context index is stale: run tools/strata-index.cmd and stage .strata/strata_index.json"; fail=1
  fi
fi

[ "$fail" -eq 0 ] || echo "pre-commit: commit blocked (fix the items above)."
exit $fail
