#!/usr/bin/env bash
# Adds attribution trailers so every commit says which task and which agent run produced it:
#   Task: <id>           from the branch name task/<id>-... (or AGENT_TASK)
#   Agent: <name>        when committed inside tools/agent.* (AGENT_NAME)
#   Run-Record: history:<runs/...md>  the record in the private history repo holding the exact
#                        instructions (AGENT_RUN_REF; see team.config.json historyRepo)
#   (not "Agent-Run": git would treat it as the same key as "Agent" and skip it)
msg="$1"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
task="${AGENT_TASK:-}"
if [ -z "$task" ]; then
  task="$(printf '%s' "$branch" | sed -n 's#^task/\(T-[0-9]\{6\}-[0-9a-f]\{4\}\).*#\1#p')"
fi
add() { grep -q "^$1:" "$msg" || git interpret-trailers --in-place --if-exists doNothing --trailer "$1: $2" "$msg"; }
[ -n "$task" ] && add "Task" "$task"
[ -n "${AGENT_NAME:-}" ] && add "Agent" "$AGENT_NAME"
[ -n "${AGENT_RUN_REF:-}" ] && add "Run-Record" "history:$AGENT_RUN_REF"
exit 0
