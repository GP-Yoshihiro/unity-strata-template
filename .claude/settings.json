{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/task.cmd list:*)",
      "Bash(tools/task.cmd show:*)",
      "Bash(tools/team.cmd status:*)",
      "Bash(tools/strata.cmd health:*)",
      "Bash(tools/strata.cmd ask:*)",
      "Bash(tools/strata-index.cmd:*)",
      "Bash(pwsh tools/task.ps1 list:*)",
      "Bash(pwsh tools/strata.ps1 health:*)",
      "Bash(pwsh tools/strata.ps1 ask:*)",
      "Bash(pwsh tools/strata-index.ps1:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.history/**)",
      "Edit(./.history/**)",
      "Edit(**/*.meta)",
      "Edit(./Library/**)",
      "Edit(./Temp/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
