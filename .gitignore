# ===== Machine-local settings (do NOT commit) =====
.unity-path.local
.env.local
.claude/settings.local.json
# Answers and progress of tools/bootstrap.ps1 on this machine
.bootstrap.local.json

# ===== Automation outputs =====
# Logs/ is kept (via .gitkeep) but its contents are per-run artifacts.
/Logs/*
!/Logs/.gitkeep
# Strata runtime data is per-machine; config + index are shared.
/.strata/cache/
/.strata/stats.json

# Codex home for local-model runs (generated per machine from tools/templates/codex-local.config.toml)
/.codex-local/

# Private agent run history (prompts / results): hidden, user-only folder created by tools/setup.*,
# synced only to the private history repo in team.config.json -- never to this repository
/.history/
